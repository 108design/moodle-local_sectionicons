<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/sectionicons/db" VERSION="2026100401" COMMENT="XMLDB file for Section Icons">
  <TABLES>
    <TABLE NAME="local_sectionicons_icon" COMMENT="Course section icon assignments">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="sectionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="icon" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="size" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="normal"/>
        <FIELD NAME="revision" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course_fk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="section_fk" TYPE="foreign" FIELDS="sectionid" REFTABLE="course_sections" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="coursesection_uix" UNIQUE="true" FIELDS="courseid,sectionid"/>
        <INDEX NAME="section_ix" UNIQUE="false" FIELDS="sectionid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_sectionicons_course" COMMENT="Course-level Section Icons display preferences">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="showcontent" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course_fk" TYPE="foreign-unique" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
